<UserControl x:Class="UVLMetadata.Views.BulkImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:UVLMetadata.Views"
             xmlns:localModels="clr-namespace:UVLMetadata.Models"
             xmlns:knarzHelperControls="clr-namespace:KNARZhelper.Controls"
             xmlns:vm="clr-namespace:UVLMetadata.ViewModels"
             xmlns:c="clr-namespace:KNARZhelper.Controls"
             d:DataContext="{d:DesignInstance Type=vm:BulkImportViewModel}"
             mc:Ignorable="d"
             d:Background="LightGray"
             d:DesignHeight="600"
             d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/UVLMetadata;component/Shared/Controls/SettingsStyles.xaml" />
                <ResourceDictionary Source="/UVLMetadata;component/Shared/Controls/CommonStyles.xaml" />
                <d:ResourceDictionary Source="/UVLMetadata;component/Localization/en_US.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                d:BorderBrush="{DynamicResource KNARZDummyBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,0,0,0" />
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                d:BorderBrush="{DynamicResource KNARZDummyBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="10">
                <Button Content="{DynamicResource LOCCloseLabel}"
                        d:Content="Close"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                        IsDefault="True"
                        Style="{DynamicResource BottomButton}"
                        d:Style="{StaticResource KNARZBottomButton}" />
            </StackPanel>
        </Border>

        <Grid Margin="15, 10"
              DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <c:SettingsSection Heading="{DynamicResource LOCUVLMetadataBulkImportSearchTag}"
                               Grid.Column="0"
                               Margin="0, 0, 15, 0"
                               Width="400">
                <DockPanel>
                    <DockPanel Margin="0, 0, 0, 15"
                               DockPanel.Dock="Top">
                        <Button Content="&#xef00;"
                                Style="{DynamicResource KNARZIconButton}"
                                Click="ClearSearchBox"
                                DockPanel.Dock="Right"
                                Margin="5,0,0,0"
                                Padding="5,5,8,5" />
                        <TextBox Name="SearchBox"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Bottom"
                                Margin="0, 15, 0, 0">
                        <Button Content="{DynamicResource LOCUVLMetadataBulkImportSearchGames}"
                                Command="{Binding SearchGamesCommand}"
                                IsEnabled="{Binding ElementName=LbTagList, Path=SelectedItems.Count}" />
                    </StackPanel>

                    <ListBox Name="LbTagList"
                             Grid.Column="1"
                             ItemsSource="{Binding TagsViewSource.View}"
                             d:ItemsSource="{d:SampleData}"
                             SelectedItem="{Binding SelectedTag}"
                             SelectionMode="Single"
                             Background="{DynamicResource NormalBrushDark}"
                             d:Background="White"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Margin"
                                                Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander Margin="0, 0, 0, 4"
                                                              Padding="2"
                                                              Tag="{Binding DataContext.GroupsExpanded, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                              Background="{DynamicResource ExpanderBackgroundBrush}"
                                                              d:Background="White">
                                                        <Expander.Style>
                                                            <Style TargetType="{x:Type Expander}"
                                                                   BasedOn="{StaticResource {x:Type Expander}}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                                                                 Value="True">
                                                                        <Setter Property="IsExpanded"
                                                                                Value="True" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Expander.Style>
                                                        <Expander.Header>
                                                            <DockPanel Margin="5"
                                                                       LastChildFill="False">
                                                                <TextBlock FontWeight="Bold"
                                                                           Text="{Binding Name}"
                                                                           FontSize="{StaticResource FontSizeLarger}"
                                                                           d:FontSize="14"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,5,0"
                                                                           DockPanel.Dock="Left"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           d:Foreground="Black" />
                                                                <TextBlock FontWeight="Bold"
                                                                           Text="{Binding ItemCount, StringFormat=({0})}"
                                                                           VerticalAlignment="Center"
                                                                           DockPanel.Dock="Right"
                                                                           Foreground="{DynamicResource HighlightGlyphBrush}"
                                                                           d:Foreground="Black" />
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <Expander.Content>
                                                            <ItemsPresenter />
                                                        </Expander.Content>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="{x:Type GroupItem}">
                                        <Setter Property="Margin"
                                                Value="0" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type GroupItem}">
                                                    <Expander IsExpanded="True"
                                                              Margin="0, 2, 0, 0"
                                                              Padding="10, 2, 2, 2"
                                                              Background="{DynamicResource ExpanderBackgroundBrush}"
                                                              d:Background="White">
                                                        <Expander.Header>
                                                            <DockPanel Margin="5"
                                                                       LastChildFill="False">
                                                                <TextBlock FontWeight="Bold"
                                                                           Text="{Binding Name}"
                                                                           FontSize="{StaticResource FontSize}"
                                                                           d:FontSize="14"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,5,0"
                                                                           DockPanel.Dock="Left"
                                                                           Foreground="{DynamicResource TextBrush}"
                                                                           d:Foreground="Black" />
                                                                <TextBlock FontWeight="Bold"
                                                                           Text="{Binding ItemCount, StringFormat=({0})}"
                                                                           FontSize="{StaticResource FontSizeSmall}"
                                                                           d:FontSize="10"
                                                                           VerticalAlignment="Center"
                                                                           DockPanel.Dock="Right"
                                                                           Foreground="{DynamicResource HighlightGlyphBrush}"
                                                                           d:Foreground="Black" />
                                                            </DockPanel>
                                                        </Expander.Header>
                                                        <Expander.Content>
                                                            <ItemsPresenter />
                                                        </Expander.Content>
                                                    </Expander>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5">
                                    <DockPanel Margin="0, 0, 0, 2">
                                        <TextBlock Text="{Binding GamesCountFormatted}"
                                                   FontSize="{StaticResource FontSizeSmall}"
                                                   d:FontSize="10"
                                                   VerticalAlignment="Center"
                                                   DockPanel.Dock="Right" />
                                        <TextBlock Text="{Binding ShortName}"
                                                   FontWeight="Bold"
                                                   Margin="0,0,5,0"
                                                   TextWrapping="Wrap"
                                                   DockPanel.Dock="Left" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               d:FontSize="10"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </c:SettingsSection>

            <c:SettingsSection Heading="{Binding FoundGamesSectionCaption}"
                               Grid.Column="1">

                <DataGrid Name="GamesGrid"
                          ItemsSource="{Binding MatchedGames}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          ColumnWidth="*"
                          CanUserSortColumns="True"
                          EnableRowVirtualization="True"
                          SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource LOCGameNameTitle}"
                                            d:Header="Name"
                                            Binding="{Binding PlayniteGame.Game.Name}"
                                            MinWidth="50"
                                            SortDirection="Ascending"
                                            SortMemberPath="PlayniteGame.RealSortingName" />
                        <DataGridTextColumn Header="{DynamicResource LOCGameReleaseYearTitle}"
                                            d:Header="Year"
                                            Binding="{Binding PlayniteGame.Game.ReleaseYear}"
                                            Width="SizeToCells" />
                        <DataGridTextColumn Header="{DynamicResource LOCPlatformsTitle}"
                                            d:Header="Platforms"
                                            Binding="{Binding PlayniteGame.Platforms}"
                                            MinWidth="50" />
                        <DataGridTextColumn Header="{DynamicResource LOCUVLMetadataBulkImportCaptionMatchedName}"
                                            d:Header="Matched name"
                                            Binding="{Binding UVLGame.Name}"
                                            MinWidth="50" />
                        <DataGridTextColumn Header="{DynamicResource LOCUVLMetadataBulkImportCaptionMatchedRelease}"
                                            d:Header="Matched year"
                                            Binding="{Binding UVLGame.ReleaseDate}"
                                            Width="SizeToCells" />
                        <DataGridTextColumn Header="{DynamicResource LOCUVLMetadataBulkImportCaptionMatchedPlatform}"
                                            d:Header="Matched platform"
                                            Binding="{Binding UVLGame.Platform}"
                                            MinWidth="50" />
                        <DataGridTextColumn Header="{DynamicResource LOCUVLMetadataBulkImportCaptionMatchingType}"
                                            d:Header="Matched by"
                                            Binding="{Binding MatchingTypeCaption}"
                                            MinWidth="50" />
                    </DataGrid.Columns>
                </DataGrid>
            </c:SettingsSection>
        </Grid>
    </DockPanel>
</UserControl>