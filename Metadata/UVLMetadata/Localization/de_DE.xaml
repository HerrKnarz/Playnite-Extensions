<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="LOCUVLMetadataName">UVL-Metadaten</sys:String>

    <sys:String x:Key="LOCUVLMetadataDialogRefreshTags">Um Tags von UVL herunterzuladen, müssen Sie sie mindestens einmal aktualisieren. Möchten Sie das jetzt tun? Es sollte nur ein paar Sekunden dauern.</sys:String>
    <sys:String x:Key="LOCUVLMetadataProgressRefreshingTags">Aktualisiere Tags...</sys:String>
    <sys:String x:Key="LOCUVLMetadataSearchDialog">wähle Spiel</sys:String>
    <sys:String x:Key="LOCUVLMetadataSearchDialogCover">wähle Coverbild</sys:String>
    <sys:String x:Key="LOCUVLMetadataSearchDialogBackground">wähle Hintergrundbild</sys:String>
    <sys:String x:Key="LOCUVLMetadataSearchDialogUrlFound">Ein Spiel mit dieser URL wurde gefunden.</sys:String>

    <sys:String x:Key="LOCUVLMetadataSettingsButtonTagsRefresh">Tags aktualisieren</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsCaptionDescriptionToUse">Zu verwendende Beschreibung</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsCaptionDescriptionToUseDescription">Wählen Sie die Art der Beschreibung für die Metadaten aus. Die andere wird als Fallback verwendet. Wenn beide verwendet werden sollen, werden sie durch eine horizontale Linie getrennt.</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsCaptionLastRefresh">Letzter Aktualisierung:</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsCaptionLastRefreshDescription">Um Tags von UVL zu importieren, müssen Sie sie mindestens einmal mit dieser Schaltfläche aktualisieren. Ich empfehle, sie einmal zu aktualisieren, um die Metadaten auf dem neuesten Stand zu halten, aber sie ändern sich meist nicht sehr häufig.</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsCaptionOnlyUseFirstDescription">Nur erste Beschreibung verwenden</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsCaptionOnlyUseFirstDescriptionDescription">UVL kann mehrere Beschreibungen für dasselbe Spiel haben. Wenn aktiviert, wird nur die erste Beschreibung des ausgewählten Typs verwendet. Andernfalls werden alle durch eine horizontale Linie abgeholt und getrennt.</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsCaptionRatingToUse">Kritische Punktzahl</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsCaptionRatingToUseDescription">Wählen Sie, welche Bewertung für die Metadaten verwendet werden soll. Die mittlere und durchschnittliche Punktzahl werden aus der Liste der Bewertungen auf der UVL-Website berechnet.</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsDescriptionToUseBoth">Beides</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsDescriptionToUseDescription">Beschreibung</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsDescriptionToUseOfficialDescription">Offizielle Beschreibung</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsRatingAverage">Durchschnitt</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsRatingMedian">Medianisch</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsSectionGeneral">Allgemein</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsSectionTags">Tags</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsSectionTagsDescription">Hier können Sie festlegen, welche Tag-Kategorien Sie als Tags, Funktionen oder Genres hinzufügen möchten und einen Präfix dafür angeben. Tags des Typs &quot;series&quot; werden immer dem Serienfeld hinzugefügt und haben keinen Präfix.</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsTagsCategory">Kategorie</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsTagsPrefix">Präfix</sys:String>
    <sys:String x:Key="LOCUVLMetadataSettingsTagsImportAs">Importieren als</sys:String>

