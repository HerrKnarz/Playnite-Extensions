    <Compile Include="..\..\KNARZhelper\KNARZhelper\Enum\DbInteractionResult.cs" Link="Shared\Enum\DbInteractionResult.cs" />
    <Compile Include="..\..\KNARZhelper\KNARZhelper\FilesCommon\FileHelper.cs" Link="Shared\FilesCommon\FileHelper.cs" />
