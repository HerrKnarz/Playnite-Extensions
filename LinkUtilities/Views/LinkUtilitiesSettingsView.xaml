<UserControl x:Class="LinkUtilities.Views.LinkUtilitiesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:LinkUtilities.ViewModels"
             xmlns:c="clr-namespace:PlayniteExtensionHelpers.UICommon.Controls"
             xmlns:p="clr-namespace:Playnite"
             xmlns:models="clr-namespace:LinkUtilities.Models"
             xmlns:ui="clr-namespace:PlayniteExtensionHelpers.UICommon"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:LinkUtilitiesSettingsHandler}"
             d:DesignHeight="600"
             d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/LinkUtilities;component/Shared/UICommon/CommonStyles.xaml" />
                <ResourceDictionary Source="/LinkUtilities;component/Shared/UICommon/Controls/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <TabControl TabStripPlacement="Top">
        <TabItem Header="{p:LocString {x:Static p:LocId.settings_tab_general}}">
            <DockPanel Margin="5, 10, 10, 5">
                <c:SettingsSection DockPanel.Dock="Top">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Settings.AddLinksToNewGames}"
                                  Content="{p:LocString {x:Static p:LocId.settings_add_links_to_new_games}}"
                                  Margin="0, 0, 0, 15" />

                        <CheckBox IsChecked="{Binding Settings.RemoveDuplicatesAfterChange}"
                                  Content="{p:LocString {x:Static p:LocId.settings_duplicates_remove_after_change}}"
                                  Margin="0, 0, 0, 15" />

                        <c:SettingsOption Heading="{p:LocString {x:Static p:LocId.settings_duplicates_remove_type}}">
                            <ComboBox ItemsSource="{Binding Path=Settings.DuplicateTypesWithCaptions}"
                                      DisplayMemberPath="Value"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding Path=Settings.RemoveDuplicatesType}"
                                      MinWidth="200" />
                        </c:SettingsOption>

                        <CheckBox IsChecked="{Binding Settings.ConvertSteamLinksAfterChange}"
                                  Content="{p:LocString {x:Static p:LocId.settings_convert_steam_links_after_change}}"
                                  Margin="0, 0, 0, 15" />

                        <CheckBox IsChecked="{Binding Settings.DebugMode}"
                                  Content="{p:LocString {x:Static p:LocId.settings_debug_mode}}" />
                    </StackPanel>
                </c:SettingsSection>
                <c:SettingsSection Heading="{p:LocString {x:Static p:LocId.settings_configure_websites}}"
                                   Description="{p:LocString {x:Static p:LocId.settings_configure_websites_description}}"
                                   HelpCommand="{Binding WebsiteHelpClickCommand}"
                                   DockPanel.Dock="Top">
                    <ListView Name="LinkSources"
                              SelectionMode="Single"
                              ItemsSource="{Binding Settings.LinkSettings}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="Auto"
                                                Header="{p:LocString {x:Static p:LocId.settings_link_name}}"
                                                DisplayMemberBinding="{Binding LinkName}" />
                                <GridViewColumn Width="Auto"
                                                Header="{p:LocString {x:Static p:LocId.settings_add_link}}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsAddable, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding IsAddableVisible}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="Auto"
                                                Header="{p:LocString {x:Static p:LocId.settings_search_link}}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSearchable, UpdateSourceTrigger=PropertyChanged}"
                                                      Visibility="{Binding IsSearchableVisible}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="Auto"
                                                Header="{p:LocString {x:Static p:LocId.settings_show_in_menus}}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding ShowInMenus, UpdateSourceTrigger=PropertyChanged}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="200"
                                                Header="{p:LocString {x:Static p:LocId.settings_api_key}}">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,-15,0"
                                                     Visibility="{Binding IsApiKeyVisible}"
                                                     VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </c:SettingsSection>
            </DockPanel>
        </TabItem>
        <TabItem Header="{p:LocString {x:Static p:LocId.settings_tab_assign_link_types}}">
            <c:SettingsSection Description="{p:LocString {x:Static p:LocId.settings_tab_assign_link_types_description}}"
                               HelpCommand="{Binding PatternHelpClickCommand}"
                               Margin="5, 10, 10, 5"
                               x:Name="TiPatternTab">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Bottom"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left">
                        <Button Content="&#xea60;"
                                ToolTip="{p:LocString {x:Static p:LocId.settings_button_add}}"
                                FontFamily="{DynamicResource NerdFont}"
                                Command="{Binding AddLinkNamePatternCommand}" />
                        <Button Content="{p:LocString {x:Static p:LocId.settings_button_add_defaults}}"
                                Margin="10,0,0,0"
                                Command="{Binding AddDefaultLinkNamePatternsCommand}" />
                        <Button Content="&#xf04ba;"
                                ToolTip="{p:LocString {x:Static p:LocId.settings_button_sort}}"
                                FontFamily="{DynamicResource NerdFont}"
                                Margin="10,0,0,0"
                                Command="{Binding SortPatternsCommand}" />
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Top">
                        <ListBox Name="LbLinkNamePatterns"
                                 DockPanel.Dock="Left"
                                 MinWidth="200"
                                 VerticalAlignment="Stretch"
                                 ItemsSource="{Binding Settings.LinkNamePatterns}"
                                 SelectedItem="{Binding SelectedPattern}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="5">
                                        <Button Content="&#xf48e;"
                                                ToolTip="{p:LocString {x:Static p:LocId.settings_button_remove}}"
                                                FontFamily="{DynamicResource NerdFont}"
                                                DockPanel.Dock="Right"
                                                Margin="10, 0, 0, 0"
                                                Command="{Binding Path=DataContext.RemoveLinkNamePatternsCommand, ElementName=TiPatternTab}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding LinkName}"
                                                   MinWidth="100"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <i:Interaction.Behaviors>
                                <ui:ScrollIntoViewBehavior />
                            </i:Interaction.Behaviors>
                        </ListBox>
                        <StackPanel DockPanel.Dock="Right"
                                    Margin="15, 0, 0, 0"
                                    d:DataContext="{d:DesignInstance Type=models:LinkNamePattern}"
                                    DataContext="{Binding SelectedPattern}"
                                    VerticalAlignment="Top">
                            <c:SettingsOption Heading="{p:LocString {x:Static p:LocId.settings_link_name}}"
                                              Description="{p:LocString {x:Static p:LocId.settings_link_name_description}}"
                                              MinLabelWidth="100">
                                <TextBox Text="{Binding LinkName}"
                                         MinWidth="100" />
                            </c:SettingsOption>

                            <c:SettingsOption Heading="{p:LocString {x:Static p:LocId.settings_name_pattern}}"
                                              Description="{p:LocString {x:Static p:LocId.settings_name_pattern_description}}"
                                              MinLabelWidth="100">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding LinkNameIsRegex}"
                                              Margin="10, 0, 0, 0"
                                              DockPanel.Dock="Right"
                                              Content="{p:LocString {x:Static p:LocId.settings_is_regex}}" />
                                    <TextBox Text="{Binding NamePattern}"
                                             MinWidth="100" />
                                </DockPanel>
                            </c:SettingsOption>

                            <c:SettingsOption Heading="{p:LocString {x:Static p:LocId.settings_url_pattern}}"
                                              Description="{p:LocString {x:Static p:LocId.settings_url_pattern_description}}"
                                              MinLabelWidth="100">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding UrlPatternIsRegex}"
                                              Margin="10, 0, 0, 0"
                                              DockPanel.Dock="Right"
                                              Content="{p:LocString {x:Static p:LocId.settings_is_regex}}" />
                                    <TextBox Text="{Binding UrlPattern}"
                                             MinWidth="100" />
                                </DockPanel>
                            </c:SettingsOption>

                            <c:SettingsOption Heading="{p:LocString {x:Static p:LocId.caption_link_type}}"
                                              Description="{p:LocString {x:Static p:LocId.settings_link_type_description}}"
                                              MinLabelWidth="100">
                                <ComboBox ItemsSource="{Binding Path=DataContext.LinkTypes, ElementName=TiPatternTab}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding Path=LinkTypeIdentifier}"
                                          MinWidth="200" />
                            </c:SettingsOption>

                            <CheckBox IsChecked="{Binding PartialMatch}"
                                      Margin="0, 0, 0, 5"
                                      Content="{p:LocString {x:Static p:LocId.settings_partial_match}}" />
                            <TextBlock Text="{p:LocString {x:Static p:LocId.settings_partial_match_description}}"
                                       Style="{StaticResource SettingsDescription}" />
                        </StackPanel>
                    </DockPanel>
                </DockPanel>
            </c:SettingsSection>
        </TabItem>
        <TabItem Header="{p:LocString {x:Static p:LocId.settings_tab_remove_links}}">
            <c:SettingsSection Description="{p:LocString {x:Static p:LocId.settings_tab_remove_links_description}}"
                               Margin="5, 10, 10, 5"
                               x:Name="TiRemovePatternTab">
                <DockPanel>
                    <StackPanel Orientation="Horizontal"
                                DockPanel.Dock="Bottom"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left">
                        <Button Content="&#xea60;"
                                ToolTip="{p:LocString {x:Static p:LocId.settings_button_add}}"
                                FontFamily="{DynamicResource NerdFont}"
                                Command="{Binding AddRemovePatternCommand}" />
                        <Button Content="{p:LocString {x:Static p:LocId.settings_button_add_defaults}}"
                                Margin="10,0,0,0"
                                Command="{Binding AddDefaultRemovePatternsCommand}" />
                        <Button Content="&#xf04ba;"
                                ToolTip="{p:LocString {x:Static p:LocId.settings_button_sort}}"
                                FontFamily="{DynamicResource NerdFont}"
                                Margin="10,0,0,0"
                                Command="{Binding SortRemovePatternsCommand}" />
                    </StackPanel>

                    <CheckBox IsChecked="{Binding Settings.RemoveUnwantedAfterChange}"
                              Content="{p:LocString {x:Static p:LocId.settings_remove_unwanted_after_change}}"
                              DockPanel.Dock="Top"
                              Margin="0, 0, 0, 15" />

                    <DockPanel DockPanel.Dock="Top">
                        <ListBox Name="LbRemovePatterns"
                                 DockPanel.Dock="Left"
                                 MinWidth="200"
                                 VerticalAlignment="Stretch"
                                 ItemsSource="{Binding Settings.RemovePatterns}"
                                 SelectedItem="{Binding SelectedRemovePattern}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="5">
                                        <Button Content="&#xf48e;"
                                                ToolTip="{p:LocString {x:Static p:LocId.settings_button_remove}}"
                                                FontFamily="{DynamicResource NerdFont}"
                                                DockPanel.Dock="Right"
                                                Margin="10, 0, 0, 0"
                                                Command="{Binding Path=DataContext.RemoveRemovePatternsCommand, ElementName=TiRemovePatternTab}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding LinkName}"
                                                   MinWidth="100"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <i:Interaction.Behaviors>
                                <ui:ScrollIntoViewBehavior />
                            </i:Interaction.Behaviors>
                        </ListBox>
                        <StackPanel DockPanel.Dock="Right"
                                    Margin="15, 0, 0, 0"
                                    d:DataContext="{d:DesignInstance Type=models:LinkNamePattern}"
                                    DataContext="{Binding SelectedRemovePattern}"
                                    VerticalAlignment="Top">
                            <c:SettingsOption Heading="{p:LocString {x:Static p:LocId.settings_link_name}}"
                                              MinLabelWidth="100">
                                <TextBox Text="{Binding LinkName}"
                                         MinWidth="100" />
                            </c:SettingsOption>

                            <c:SettingsOption Heading="{p:LocString {x:Static p:LocId.settings_url_pattern}}"
                                              Description="{p:LocString {x:Static p:LocId.settings_url_pattern_description}}"
                                              MinLabelWidth="100">
                                <DockPanel>
                                    <CheckBox IsChecked="{Binding UrlPatternIsRegex}"
                                              Margin="10, 0, 0, 0"
                                              DockPanel.Dock="Right"
                                              Content="{p:LocString {x:Static p:LocId.settings_is_regex}}" />
                                    <TextBox Text="{Binding UrlPattern}"
                                             MinWidth="100" />
                                </DockPanel>
                            </c:SettingsOption>

                            <c:SettingsOption Heading="{p:LocString {x:Static p:LocId.caption_link_type}}"
                                              Description="{p:LocString {x:Static p:LocId.settings_remove_link_type_description}}"
                                              MinLabelWidth="100">
                                <ComboBox ItemsSource="{Binding Path=DataContext.LinkTypes, ElementName=TiRemovePatternTab}"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"
                                          SelectedValue="{Binding Path=LinkTypeIdentifier}"
                                          MinWidth="200" />
                            </c:SettingsOption>
                        </StackPanel>
                    </DockPanel>
                </DockPanel>
            </c:SettingsSection>
        </TabItem>
    </TabControl>
</UserControl>