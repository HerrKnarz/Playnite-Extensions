<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOCGGDealsWishlistPluginName">GG.dealsウィッシュリスト</sys:String>

    <sys:String x:Key="LOCGGDealsWishlistConfigNotice">GG.dealsからゲームをインポートするには、アドオン設定にウィッシュリストのURLを追加する必要があります。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountBuyOn">購入先</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountClickToCopyCode">クリックしてコードをコピー：</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountCodeCopied">コードをコピーしました！</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountFilter">フィルター</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountGoTo">移動先</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountGroupBy">Group by</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountHistoricalLow">過去最安値</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountShowOnlyDiscounted">割引中のゲームのみ表示</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountShowOnlyHistoricalLow">過去最安値のゲームのみ表示</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountSortBy">並べ替え</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistGroupByCompletionStatus">Completion Status</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistGroupByNone">None</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistGroupByShop">Shop</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionGGDealsBanner">GG.deals バナー</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionCover">ゲームカバー</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionIcon">ゲームアイコン</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistMenuDiscountView">現在の割引</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistProgessLoadingDiscountData">GG.deals から割引データを読み込み中…</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistRefresh">更新</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDebugMode">デバッグモード</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDebugModeDescription">extensions.log に詳細なデバッグメッセージを記録します</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDefaultCategory">既定のカテゴリー</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDefaultCategoryDescription">GG.dealsウィッシュリストからインポートしたゲームに使用する既定のカテゴリーです。空欄のままにできます。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountImageOption">割引ビューの画像</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountImageOptionDescription">割引ビューで各ゲームに表示される画像です。GG.deals バナーは、表示時に Web からリアルタイムで読み込まれます。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountViewSettings">割引ビュー設定</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplayTopPanelButton">トップパネルボタンを表示</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplayTopPanelButtonDescription">有効にすると、割引ビューにアクセスするためのボタンがトップパネルに表示されます。反映するには Playnite の再起動が必要です。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplaySidebarButton">サイドバーボタンを表示</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplaySidebarButtonDescription">有効にすると、割引ビューにアクセスするためのボタンがサイドバーに表示されます。反映するには Playnite の再起動が必要です。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsFilterTip">💡ヒント: ウィッシュリストからインポートしたいアイテムを絞り込むには、共有可能なリンクをブラウザーで開き、そのページでフィルター設定を変更します。その後、フィルター設定が追加されたリンクをブラウザーからコピーして、ウィッシュリストURL欄に戻してください。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsGeneral">一般</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsHistoricalLowColor">過去最安値の色</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsHistoricalLowColorDescription">割引ビューで過去最安値を強調表示するために使用される色です。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportAsInstalled">ゲームをインストール済みとしてインポート</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportAsInstalledDescription">ウィッシュリストのゲームをインストール済みとしてインポートします。「プレイ」をクリックすると、GG.dealsのゲームページに移動します。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportSettings">インポート設定</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportToLibrary">ゲームを Playnite にインポート</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportToLibraryDescription">有効にすると、ウィッシュリスト内のゲームが Playnite にインポートされます。インポートされたゲームはライブラリ内の他のゲームと同じように表示され、割引ビューで追加オプションを使用できるようになります。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsMaxGamesToImport">インポートするゲームの最大数</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsMaxGamesToImportDescription">1回の実行でGG.dealsウィッシュリストからインポートするゲームの最大数です。アドオンのインストール後に初回インポートを行う際、レート制限に達したり、メタデータプロバイダーからブロックされたりするのを避けるのに役立ちます。0に設定すると、アドオンはすべてのゲームを一度にインポートします。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsOnlyImportGames">ゲームのみインポート</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsOnlyImportGamesDescription">有効にすると、ウィッシュリストに登録されたゲームと「パック」（複数のゲームが1つになったもの）のみがインポートされます。ウィッシュリスト内のDLCやその他のメディアもインポートしたい場合は、これを無効にしてください。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsPluginWarning">⚠️ 警告：GG.deals の汎用アドオンもインストールされています。ウィッシュリストを Playnite にインポートする場合は、そのアドオンの設定で GG.deals Wishlist ライブラリをエクスポート対象から外してください。そうしないと、ウィッシュリストアドオンによって追加されたゲームが GG.deals で所有済みとして追加され、ウィッシュリストから削除されます！</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsSelect">選択</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsWishlistUrl">選択してください</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsWishlistUrlDescription">GG.dealsウィッシュリストのURLです。このアドオンは共有可能なリンクでのみ動作します。取得するには、ウィッシュリストページで「Share list」を有効にし、「copy shareable link」をクリックしてください。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderDiscount">割引</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderName">名前</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderPrice">価格</sys:String>
</ResourceDictionary>
