<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOCGGDealsWishlistPluginName">GG.dealsウィッシュリスト</sys:String>

    <sys:String x:Key="LOCGGDealsWishlistConfigNotice">GG.dealsからゲームをインポートするには、アドオン設定にウィッシュリストのURLを追加する必要があります。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountBuyOn">Buy on</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountClickToCopyCode">Click to copy code:</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountCodeCopied">Code copied!</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountFilter">Filter</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountGoTo">Go to</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountGroupByShop">Group by shop</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountHistoricalLow">Historical low</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountShowOnlyDiscounted">Show only discounted games</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountShowOnlyHistoricalLow">Show only historical low prices</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountSortBy">Sort by</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionGGDealsBanner">GG.deals banner</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionCover">Game cover</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionIcon">Game icon</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistMenuDiscountView">Current discounts</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistProgessLoadingDiscountData">Loading discount data from GG.deals...</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistRefresh">Refresh</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDebugMode">デバッグモード</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDebugModeDescription">extensions.log に詳細なデバッグメッセージを記録します</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDefaultCategory">既定のカテゴリー</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDefaultCategoryDescription">GG.dealsウィッシュリストからインポートしたゲームに使用する既定のカテゴリーです。空欄のままにできます。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountImageOption">Image in Discount View</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountImageOptionDescription">The image that will be displayed for each game in the Discount View. The GG.deals banner will be loaded live from the web when displayed.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountViewSettings">Discount View Settings</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplayTopPanelButton">Display Top Panel Button</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplayTopPanelButtonDescription">When enabled, a button will be displayed in the top panel to access the discount view. Requires a restart of Playnite to take effect.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplaySidebarButton">Display Sidebar Button</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplaySidebarButtonDescription">When enabled, a button will be displayed in the sidebar to access the discount view. Requires a restart of Playnite to take effect.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsFilterTip">💡ヒント: ウィッシュリストからインポートしたいアイテムを絞り込むには、共有可能なリンクをブラウザーで開き、そのページでフィルター設定を変更します。その後、フィルター設定が追加されたリンクをブラウザーからコピーして、ウィッシュリストURL欄に戻してください。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsGeneral">General</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsHistoricalLowColor">Historical Low Color</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsHistoricalLowColorDescription">The color used to highlight historical low prices in the discount view.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportAsInstalled">ゲームをインストール済みとしてインポート</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportAsInstalledDescription">ウィッシュリストのゲームをインストール済みとしてインポートします。「プレイ」をクリックすると、GG.dealsのゲームページに移動します。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportSettings">Import Settings</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportToLibrary">Import Games to Playnite</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportToLibraryDescription">When enabled the games from your wishlist will be imported to Playnite. The games will appear like any other game in your library which in turn will enable additional options in the discount view.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsMaxGamesToImport">インポートするゲームの最大数</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsMaxGamesToImportDescription">1回の実行でGG.dealsウィッシュリストからインポートするゲームの最大数です。アドオンのインストール後に初回インポートを行う際、レート制限に達したり、メタデータプロバイダーからブロックされたりするのを避けるのに役立ちます。0に設定すると、アドオンはすべてのゲームを一度にインポートします。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsOnlyImportGames">ゲームのみインポート</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsOnlyImportGamesDescription">有効にすると、ウィッシュリストに登録されたゲームと「パック」（複数のゲームが1つになったもの）のみがインポートされます。ウィッシュリスト内のDLCやその他のメディアもインポートしたい場合は、これを無効にしてください。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsPluginWarning">⚠️ Warning: You also have the GG.deals generic addon installed. Please make sure to deactivate the GG.deals Wishlist library from export in that addon's settings if you want to import your wishlist to Playnite. Otherwise the games added by the wishlist addon will be added to GG.deals as owned and removed from the wishlist!</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsSelect">選択</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsWishlistUrl">選択してください</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsWishlistUrlDescription">GG.dealsウィッシュリストのURLです。このアドオンは共有可能なリンクでのみ動作します。取得するには、ウィッシュリストページで「Share list」を有効にし、「copy shareable link」をクリックしてください。</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderDiscount">Discount</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderName">Name</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderPrice">Price</sys:String>
</ResourceDictionary>
