<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOCGGDealsWishlistPluginName">GG.deals Wunschliste</sys:String>

    <sys:String x:Key="LOCGGDealsWishlistConfigNotice">Du musst deine Wunschlisten-URL in den Addon-Einstellungen angeben, um Spiele von GG.deals importieren zu können.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountBuyOn">Kaufen auf</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountClickToCopyCode">Zum Kopieren klicken:</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountCodeCopied">Code kopiert!</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountFilter">Filtern</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountGoTo">Gehe zu</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountGroupByShop">Nach Shop gruppieren</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountHistoricalLow">Historisch niedrig</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountShowOnlyDiscounted">Nur reduzierte Spiele anzeigen</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountShowOnlyHistoricalLow">Nur historische niedrige Preise anzeigen</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountSortBy">Sortieren nach</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionGGDealsBanner">GG.Deals-Banner</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionCover">Spielcover</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionIcon">Spielsymbol</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistMenuDiscountView">Aktuelle Rabatte</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistProgessLoadingDiscountData">Lade Rabattdaten von GG.deals...</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistRefresh">Aktualisieren</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDebugMode">Debug-Modus</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDebugModeDescription">Aktiviert ausführliche Debug-Nachrichten in der extensions.log</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDefaultCategory">Standardkategorie</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDefaultCategoryDescription">Die Standard-Kategorie für Spiele, die von Ihrer GG.deals Wunschliste importiert werden. Kann leer gelassen werden.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountImageOption">Bild in Rabattansicht</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountImageOptionDescription">Das Bild, das für jedes Spiel in der Discount Ansicht angezeigt wird. Der GG.Deales-Banner wird live aus dem Web geladen, wenn er angezeigt wird.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountViewSettings">Rabattansicht-Einstellungen</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplayTopPanelButton">Top Panel Button anzeigen</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplayTopPanelButtonDescription">Wenn aktiviert, wird eine Schaltfläche in der oberen Leiste angezeigt, um auf die Rabatt-Ansicht zuzugreifen. Benötigt einen Neustart von Playnite um wirksam zu werden.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplaySidebarButton">Seitenleisten-Button anzeigen</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDisplaySidebarButtonDescription">Wenn aktiviert, wird in der Seitenleiste eine Schaltfläche angezeigt, um auf die Rabatt-Ansicht zuzugreifen. Zum Aktivieren eines Neustarts von Playnite wird eine Option benötigt.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsFilterTip">💡Tip: Um zu filtern, welche Elemente du aus deiner Wunschliste importieren möchtest, kannst du den &quot;shareable Link&quot; in deinem Browser öffnen, einige der Filtereinstellungen auf dieser Seite ändern und dann den Link mit den Filtereinstellungen aus dem Browser zurück in das Feld Wunschlisten-URL kopieren.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsGeneral">Allgemein</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsHistoricalLowColor">Historische Niedrige Farbe</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsHistoricalLowColorDescription">Die Farbe verwendet, um historische niedrige Preise in der Rabattansicht hervorzuheben.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportAsInstalled">Spiele als installiert importieren</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportAsInstalledDescription">Importiert Spiele von deiner Wunschliste als installiert. Mit einem Klick auf Play gelangst du auf die Spielseite auf GG.deals.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportSettings">Import-Einstellungen</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportToLibrary">Spiele nach Playnite importieren</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportToLibraryDescription">Wenn aktiviert, werden die Spiele von Ihrer Wunschliste nach Playnite importiert. Die Spiele erscheinen wie jedes andere Spiel in deiner Bibliothek, die wiederum zusätzliche Optionen in der Rabatt-Ansicht aktivieren.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsMaxGamesToImport">Maximale Anzahl zu importierender Spiele</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsMaxGamesToImportDescription">Die maximale Anzahl an Spielen, die von Ihrer GG.deals Wunschliste pro Run. Nützlich für den ersten Import nach der Installation des Addons, so dass Sie keine Ratenzahlungen oder Sperrung von Metadatenanbietern treffen. Wenn auf 0 gesetzt wird das Addon alle Spiele auf einmal importieren.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsOnlyImportGames">Nur Spiele importieren</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsOnlyImportGamesDescription">Wenn aktiviert, werden nur Spiele und &quot;Packs&quot; (mehrere Spiele in einem) importiert. Deaktiviere dies, wenn du auch DLCs und andere Medien aus deiner Wunschliste importieren möchtest.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsPluginWarning">:warnung: Sie haben auch das GG.deals generische Addon installiert. Bitte stellen Sie sicher, dass Sie das GG deaktivieren. eals Wishlist-Bibliothek vom Export in die Einstellungen dieses Addons wenn Sie Ihre Wunschliste nach Playnite importieren möchten. Andernfalls werden die Spiele, die vom Wunschlisten-Addon hinzugefügt werden, in GG.deals als Eigentum hinzugefügt und von der Wunschliste entfernt!</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsSelect">Auswählen</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsWishlistUrl">Wunschlisten-URL</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsWishlistUrlDescription">Die URL deiner GG.deals-Wunschliste. Das Addon funktioniert nur mit dem &quot;shareable Link&quot;. Um ihn zu erhalten, musst du auf der Wunschliste die Option &quot;Share list&quot; aktivieren und auf &quot;copy shareable link&quot; klicken.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderDiscount">Rabatt</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderName">Name</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderPrice">Preis</sys:String>
</ResourceDictionary>
