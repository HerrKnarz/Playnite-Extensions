<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOCGGDealsWishlistPluginName">GG.deals Wishlist</sys:String>

    <sys:String x:Key="LOCGGDealsWishlistConfigNotice">You need to add your wishlist url to the addon settings to be able to import games from GG.deals.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountBuyOn">Buy on</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountClickToCopyCode">Click to copy code:</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountCodeCopied">Code copied!</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountFilter">Filter</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountGoTo">Go to</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountGroupByShop">Group by shop</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountHistoricalLow">Historical low</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountShowOnlyDiscounted">Show only discounted games</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountShowOnlyHistoricalLow">Show only historical low prices</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistDiscountSortBy">Sort by</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionGGDealsBanner">GG.deals banner</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionCover">Game cover</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistImageOptionIcon">Game icon</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistMenuDiscountView">Current discounts</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistProgessLoadingDiscountData">Loading discount data from GG.deals...</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistRefresh">Refresh</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDebugMode">Debug mode</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDebugModeDescription">Enables verbose debug messages in the extensions.log</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDefaultCategory">Default Category</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDefaultCategoryDescription">The default category for games imported from your GG.deals wishlist. Can be left empty.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountImageOption">Image in Discount View</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsDiscountImageOptionDescription">The image that will be displayed for each game in the Discount View. The GG.deals banner will be loaded live from the web when displayed.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsFilterTip">💡Tip: To filter which items you want to import from your wishlist you can open the shareable link in your browser, change some of the filter settings on that page, and then copy the link with the added filter settings from the browser back into the wishlist URL field.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsHistoricalLowColor">Historical Low Color</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsHistoricalLowColorDescription">The color used to highlight historical low prices in the discount view.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportAsInstalled">Import Games as Installed</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsImportAsInstalledDescription">Import games from your wishlist as installed. Clicking on Play sends you to the game's page on GGDeals.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsMaxGamesToImport">Max Games to Import</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsMaxGamesToImportDescription">The maximum number of games to import from your GG.deals wishlist per run. Useful for the initial import after installing the addon, so you don't hit rate limits or get blocked from metadata providers. When set to 0 the addon will import all games at once.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsOnlyImportGames">Only import games</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsOnlyImportGamesDescription">When active only wishlisted games and "packs" (several games in one) will be imported. Deactivate this if you also want to import DLC and other media on your wishlist.</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsPluginWarning">⚠️ Warning: You also have the GG.deals generic addon installed. Please make sure to deactivate the GG.deals Wishlist library from export in that addon's settings. Otherwise the games added by the wishlist addon will be added to GG.deals as owned and removed from the wishlist!</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsSelect">Select</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsWishlistUrl">Wishlist URL</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSettingsWishlistUrlDescription">The URL of your GGDeals wishlist. The addon only works with the shareable link. To obtain it you need to activate "Share list" on the wishlist page and click "copy shareable link".</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderDiscount">Discount</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderName">Name</sys:String>
    <sys:String x:Key="LOCGGDealsWishlistSortOrderPrice">Price</sys:String>
</ResourceDictionary>