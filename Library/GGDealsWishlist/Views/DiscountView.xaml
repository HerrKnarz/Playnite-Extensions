<UserControl x:Class="GGDealsWishlist.Views.DiscountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GGDealsWishlist.Views"
             xmlns:knarzHelperControls="clr-namespace:KNARZhelper.Controls"
             xmlns:models="clr-namespace:GGDealsWishlist.Models"
             xmlns:vm="clr-namespace:GGDealsWishlist.ViewModels"
             xmlns:c="clr-namespace:KNARZhelper.Controls"
             d:DataContext="{d:DesignInstance Type=vm:DiscountViewModel}"
             mc:Ignorable="d"
             d:Background="LightGray"
             d:DesignHeight="800"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <d:ResourceDictionary Source="/GGDealsWishlist;component/Localization/en_US.xaml" />
                <ResourceDictionary Source="/GGDealsWishlist;component/Shared/Controls/CommonStyles.xaml" />
                <ResourceDictionary Source="/GGDealsWishlist;component/Shared/Controls/SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <knarzHelperControls:LocalFileImageConverter x:Key="LocalFileImageConverter" />

            <SolidColorBrush x:Key="GGDealsHoverBrush"
                             Color="{DynamicResource TextColor}"
                             Opacity="0.05" />
            <SolidColorBrush x:Key="GGDealsSelectedBrush"
                             Color="{DynamicResource TextColor}"
                             Opacity="0.08" />
            <SolidColorBrush x:Key="GGDealsHighlightBrush"
                             Color="{DynamicResource TextColor}"
                             Opacity="0.2" />
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                d:BorderBrush="{DynamicResource KNARZDummyBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,0,0,0" />
        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource WindowPanelSeparatorBrush}"
                d:BorderBrush="{DynamicResource KNARZDummyBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,0,0,0">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="10">
                <Button Content="{DynamicResource LOCCloseLabel}"
                        d:Content="Close"
                        Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"
                        IsDefault="True"
                        Style="{DynamicResource BottomButton}"
                        d:Style="{StaticResource KNARZBottomButton}" />
            </StackPanel>
        </Border>

        <Grid Margin="15, 10"
              DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:SettingsSection Heading="{Binding Source={StaticResource LOCGGDealsWishlistDiscountFilter}}"
                               Grid.Column="0"
                               Margin="0, 0, 15, 0">
                <DockPanel LastChildFill="False">
                    <DockPanel Margin="0, 0, 0, 15"
                               DockPanel.Dock="Top">
                        <Button Content="&#xef00;"
                                Style="{DynamicResource KNARZIconButton}"
                                Click="ClearSearchBox"
                                DockPanel.Dock="Right"
                                Margin="5,0,0,0"
                                Padding="5,5,8,5" />
                        <TextBox Name="SearchBox"
                                 Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <Label Content="{Binding Source={StaticResource LOCGGDealsWishlistDiscountSortBy}}"
                           Margin="0, 0, 0, 5"
                           DockPanel.Dock="Top" />
                    <ComboBox Name="SortOrderComboBox"
                              ItemsSource="{Binding Path=SortOrderWithCaptions}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              SelectedValue="{Binding SortOrder}"
                              Margin="0, 0, 0, 15"
                              DockPanel.Dock="Top" />
                    <Label Content="{Binding Source={StaticResource LOCGGDealsWishlistDiscountGroupBy}}"
                           Margin="0, 0, 0, 5"
                           DockPanel.Dock="Top" />
                    <ComboBox Name="GroupByComboBox"
                              ItemsSource="{Binding Path=GroupByWithCaptions}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              SelectedValue="{Binding GroupBy}"
                              Margin="0, 0, 0, 25"
                              DockPanel.Dock="Top" />
                    <CheckBox Content="{Binding Source={StaticResource LOCGGDealsWishlistDiscountShowOnlyDiscounted}}"
                              IsChecked="{Binding ShowOnlyDiscountedGames}"
                              Margin="0, 0, 0, 15"
                              DockPanel.Dock="Top" />
                    <CheckBox Content="{Binding Source={StaticResource LOCGGDealsWishlistDiscountShowOnlyHistoricalLow}}"
                              IsChecked="{Binding ShowOnlyHistoricalLowPrices}"
                              Margin="0, 0, 0, 15"
                              DockPanel.Dock="Top" />
                    <Button Command="{Binding RefreshDiscountsCommand}"
                            DockPanel.Dock="Bottom"
                            HorizontalAlignment="Left"
                            Style="{DynamicResource BottomButton}"
                            d:Style="{StaticResource KNARZBottomButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xefd1;"
                                       FontFamily="{DynamicResource FontIcoFont}"
                                       d:FontFamily="IcoFont"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={StaticResource LOCGGDealsWishlistRefresh}}"
                                       Margin="5,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </c:SettingsSection>

            <ListBox Name="LbDiscountList"
                     Grid.Column="1"
                     ItemsSource="{Binding GamesViewSource.View}"
                     d:ItemsSource="{d:SampleData}"
                     SelectedItem="{Binding SelectedGame}"
                     SelectionMode="Single"
                     Background="{DynamicResource NormalBrushDark}"
                     d:Background="White"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Margin"
                                        Value="0,5" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <Expander IsExpanded="True"
                                                      Background="{DynamicResource ExpanderBackgroundBrush}">
                                                <Expander.Header>
                                                    <DockPanel Margin="10">
                                                        <TextBlock FontWeight="Bold"
                                                                   Text="{Binding Name}"
                                                                   FontSize="{StaticResource FontSizeLarger}"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,5,0"
                                                                   Width="Auto"
                                                                   Foreground="{DynamicResource TextBrush}" />
                                                        <TextBlock FontWeight="Bold"
                                                                   Text="{Binding ItemCount, StringFormat={}({0})}"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{DynamicResource HighlightGlyphBrush}" />
                                                    </DockPanel>
                                                </Expander.Header>
                                                <Expander.Content>
                                                    <ItemsPresenter />
                                                </Expander.Content>
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem"
                           BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Margin"
                                Value="10, 10, 0, 0" />
                        <Setter Property="Padding"
                                Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                    <Border Background="{DynamicResource NormalBrush}"
                                            d:Background="White"
                                            CornerRadius="{DynamicResource ControlCornerRadius}">
                                        <Grid>
                                            <Border x:Name="HoverRectangle"
                                                    IsHitTestVisible="False"
                                                    Visibility="Collapsed"
                                                    Background="{DynamicResource GGDealsHoverBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                                            <Border x:Name="SelectedRectangle"
                                                    IsHitTestVisible="False"
                                                    Visibility="Collapsed"
                                                    Background="{DynamicResource GGDealsSelectedBrush}"
                                                    CornerRadius="{DynamicResource ControlCornerRadius}" />
                                            <Border Padding="{TemplateBinding Padding}"
                                                    Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Margin="0" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsFocused"
                                                 Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible"
                                                    TargetName="SelectedRectangle" />
                                        </Trigger>
                                        <Trigger Property="IsSelected"
                                                 Value="true">
                                            <Setter Property="Visibility"
                                                    Value="Visible"
                                                    TargetName="SelectedRectangle" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver"
                                                           Value="True" />
                                                <Condition Property="Selector.IsSelected"
                                                           Value="False" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Visibility"
                                                    Value="Visible"
                                                    TargetName="HoverRectangle" />
                                        </MultiTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="Selector.IsSelected"
                                     Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="10">

                            <Image Source="{Binding DisplayImage, Converter={StaticResource LocalFileImageConverter}}"
                                   d:Source="/GGDealsWishlist;component/Resources/dummy-600x900.png"
                                   RenderOptions.BitmapScalingMode="Fant"
                                   Stretch="Uniform"
                                   MaxWidth="188"
                                   MaxHeight="188"
                                   DockPanel.Dock="Left" />

                            <StackPanel DockPanel.Dock="Right"
                                        VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <TextBlock Margin="15, 3, 0, 3"
                                               VerticalAlignment="Center"
                                               Text="{Binding DiscountData.RegularPriceString}"
                                               TextDecorations="Strikethrough"
                                               Foreground="{StaticResource TextBrushDarker}"
                                               d:Foreground="Gray"
                                               Visibility="{Binding DiscountData.DiscountedVisibility}" />
                                    <Border Margin="10, 3, 0, 3"
                                            VerticalAlignment="Center"
                                            CornerRadius="5"
                                            Padding="10, 3"
                                            Visibility="{Binding DiscountData.DiscountedVisibility}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{StaticResource GGDealsHighlightBrush}"
                                                        d:Value="Aqua" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiscountData.HistoricalLow}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{Binding Settings.HistoricalLowBrush}"
                                                                d:Value="DarkGreen" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DiscountData.DiscountString}" />
                                    </Border>
                                    <TextBlock Margin="10, 3, 0, 3"
                                               VerticalAlignment="Center"
                                               Text="{Binding DiscountData.DiscountedPriceString}"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource FontSizeLargest}"
                                               d:FontSize="16"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DiscountData.HistoricalLow}"
                                                                 Value="True">
                                                        <Setter Property="Foreground"
                                                                Value="{Binding Settings.HistoricalLowBrush}"
                                                                d:Value="DarkGreen" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Border Margin="10, 3, 0, 3"
                                            VerticalAlignment="Center"
                                            CornerRadius="5"
                                            Padding="10, 2"
                                            BorderBrush="{StaticResource GGDealsHighlightBrush}"
                                            d:BorderBrush="Aqua"
                                            BorderThickness="1"
                                            Visibility="{Binding DiscountData.DiscountCodeVisibility}">
                                        <TextBlock Text="{Binding DiscountData.DiscountCode}"
                                                   Foreground="{StaticResource TextBrushDarker}"
                                                   d:Foreground="Gray">
                                            <TextBlock.ToolTip>
                                                <ToolTip>
                                                    <TextBlock>
                                                    <TextBlock Text="{DynamicResource LOCGGDealsWishlistDiscountClickToCopyCode}" />
                                                    <TextBlock FontWeight="Bold"
                                                               Text="{Binding DiscountData.DiscountCodeValue}" />
                                                </TextBlock>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                            <TextBlock.InputBindings>
                                                <MouseBinding Command="{Binding CopyCodeCommand}"
                                                              MouseAction="LeftClick" />
                                            </TextBlock.InputBindings>
                                        </TextBlock>
                                    </Border>

                                    <Border Margin="10, 3, 0, 3"
                                            VerticalAlignment="Center"
                                            CornerRadius="5"
                                            Padding="10, 2"
                                            BorderBrush="{Binding Settings.HistoricalLowBrush}"
                                            d:BorderBrush="DarkGreen"
                                            BorderThickness="1"
                                            Visibility="{Binding DiscountData.HistoricalLowVisibility}">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.1"
                                                             Color="{Binding Settings.HistoricalLowColor}" />
                                        </Border.Background>
                                        <TextBlock Text="{DynamicResource LOCGGDealsWishlistDiscountHistoricalLow}"
                                                   Foreground="{Binding Settings.HistoricalLowBrush}"
                                                   d:Foreground="DarkGreen" />
                                    </Border>

                                    <TextBlock Margin="10, 3, 0, 3"
                                               VerticalAlignment="Center"
                                               Tag="{Binding DiscountData.ShopName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"
                                                   BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <Trigger Property="Tag"
                                                             Value="{x:Null}">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </Trigger>
                                                    <Trigger Property="Tag"
                                                             Value="">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    <TextBlock Text="{DynamicResource LOCGGDealsWishlistDiscountBuyOn}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrushDarker}"
                                               d:Foreground="Gray" />
                                    <Hyperlink NavigateUri="{Binding DiscountData.ShopLink}"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        <TextBlock Text="{Binding Path=DiscountData.ShopName}" />
                                    </Hyperlink>
                                </TextBlock>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel DockPanel.Dock="Left"
                                        VerticalAlignment="Center">
                                <TextBlock Margin="15, 3, 0, 3"
                                           VerticalAlignment="Center"
                                           Text="{Binding DisplayName}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource FontSizeLarger}"
                                           d:FontSize="16"
                                           FontWeight="Bold" />

                                <TextBlock Margin="15, 3, 0, 3"
                                           VerticalAlignment="Center"
                                           Text="{Binding Game.CompletionStatus}"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextBrushDarker}"
                                           d:Foreground="Gray" />

                                <TextBlock Margin="15, 3, 0, 3"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap">
                                    <TextBlock Text="{DynamicResource LOCGGDealsWishlistDiscountGoTo}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextBrushDarker}"
                                               d:Foreground="Gray" />
                                    <Hyperlink NavigateUri="{Binding GGDealsLink}"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        GG.deals
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>